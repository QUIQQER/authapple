<quiqqer>
    <package>
        <title>
            <locale group="quiqqer/authapple" var="package.title"/>
        </title>

        <description>
            <locale group="quiqqer/authapple" var="package.description"/>
        </description>

        <capabilities schemaVersion="1">
            <capability id="authentication.apple-sign-in">
                <title>Sign in with Apple</title>
                <description>
                    Authenticates QUIQQER users through verified Sign in with Apple identity tokens and linked user accounts.
                </description>
            </capability>

            <capability id="identity.apple-registration">
                <title>Apple account registration</title>
                <description>
                    Registers QUIQQER users from verified Apple identity data and links the Apple subject to the new account.
                </description>
            </capability>
        </capabilities>

        <image src="URL_OPT_DIR/quiqqer/authapple/bin/images/Logo.png"/>

        <support>
            <email><![CDATA[support@pcsg.de]]></email>
            <forum><![CDATA[https://community.quiqqer.com]]></forum>
            <source><![CDATA[https://dev.quiqqer.com/quiqqer/authapple]]></source>
            <issues><![CDATA[https://dev.quiqqer.com/quiqqer/authapple/issues]]></issues>
            <wiki><![CDATA[https://dev.quiqqer.com/quiqqer/authapple/wikis/home]]></wiki>
        </support>

        <copyright>
            <name><![CDATA[PCSG - Computer & Internet Service OHG]]></name>
            <license><![CDATA[GPL-3.0-or-later]]></license>
        </copyright>

        <provider>
            <auth src="\QUI\Apple\Auth"/>
            <registrar src="\QUI\Apple\Registrar"/>
        </provider>
    </package>
</quiqqer>
